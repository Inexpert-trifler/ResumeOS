# ══════════════════════════════════════════════════════════════════════════════
# ResumeOS — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER put real secrets in this file — it is committed to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Clerk (Backend — NEVER expose to browser) ─────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Needed by @clerk/express for local JWT verification (server-side only)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ── Clerk (Frontend — safe, prefixed with NEXT_PUBLIC_) ───────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Frontend API ──────────────────────────────────────────────────────────────
# Same-origin frontend proxy target used by /api/backend/* routes.
# In production, point this at the Render backend URL.
BACKEND_INTERNAL_URL=https://resumeos-j2u9.onrender.com/api

# ── Supabase PostgreSQL — SERVER ONLY, NEVER expose to browser ────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection Pooling
# Use Session Pooler (port 5432)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=10

# ── Optional: AI (Sprint 4) ───────────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
